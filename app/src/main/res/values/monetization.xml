    <!-- One-time Pro product created in Play Console → Monetize → Products. -->
    <string name="pro_product_id" translatable="false">picasso_pro</string>

    <!-- AdMob IDs. Demo values show test ads; replace with yours before release.
         https://developers.google.com/admob/android/test-ads -->
    <string name="admob_banner_id" translatable="false">ca-app-pub-3940256099942544/6300978111</string>
</resources>
